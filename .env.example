# Copy this file to .env:  cp .env.example .env

# Local SQLite database. Leave as is.
DATABASE_URL="file:./dev.db"

# Needed for AI match scoring, company research, CV drafts, ATS checks and interview prep.
# The app runs without it, those buttons just show an error.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
